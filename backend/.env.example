DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/disaster_response
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INDICTRANS_MODEL_PATH=models/indictrans2-en-indic-dist-200M
# auto uses an NVIDIA CUDA GPU when PyTorch detects one; otherwise it uses CPU.
INDICTRANS_DEVICE=auto
# Number of source strings translated together on an uncached bundle request.
INDICTRANS_BATCH_SIZE=4
# Greedy decoding is recommended for short API/UI translations during local development.
INDICTRANS_NUM_BEAMS=1
